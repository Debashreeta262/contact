# Copy to .env (on Windows: copy .env.example .env) and fill in real values.

# MongoDB connection string (local install or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/contact_manager

# Server port
PORT=5000

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
